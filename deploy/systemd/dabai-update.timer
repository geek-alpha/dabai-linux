[Unit]
Description=定时检查大白新版
Documentation=file:/home/wxf/dabai/deploy/release/README.md

[Timer]
# 每次启动后先查一次：等系统稳下来再动，免得把启动期的负载当成异常
OnBootSec=2min
# 之后每小时查一次：检查本身只是「读一个版本号」（1 个 API 请求），有新版才下载重启。
# 每天只查一次的话，新版可能要等 24 小时才装上 —— 那才是真正的「检查那么久」。
OnCalendar=*-*-* *:17:00
# 各机器错开最多 5 分钟，避免同时打 GitHub API、同时重启
RandomizedDelaySec=5m
AccuracySec=1min
# 关机错过了就在开机后补跑一次
Persistent=true

[Install]
WantedBy=timers.target

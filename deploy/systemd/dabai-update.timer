[Unit]
Description=定时检查大白新版
Documentation=file:/home/wxf/dabai/deploy/release/README.md

[Timer]
# 每次启动后先查一次：等系统稳下来再动，免得把启动期的负载当成异常
OnBootSec=3min
# 之后每天 04:30 再查一次——这个点几乎不会有人在跟我说话，重启打断的成本最低
OnCalendar=*-*-* 04:30:00
# 三台机器错开最多 30 分钟，避免同时打 GitHub API、同时重启
RandomizedDelaySec=30m
AccuracySec=1min
# 关机错过了就在开机后补跑一次
Persistent=true

[Install]
WantedBy=timers.target

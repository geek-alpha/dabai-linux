codex_runtime.json.tmp
codex_logs/

# 角色对话轮断点（热重载续跑运行时状态，勿提交）
data/turn_checkpoints/

# 前缀断点探针状态（只存消息指纹与工具清单，跨轮比对用，勿提交）
data/prefix_state.json

